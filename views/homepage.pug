doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        a(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Element
                    th Power Level
            tbody
                each record in data
                    tr
                        td #{record.properties.name}
                        td #{record.properties.element}
                        td #{record.properties.power_level}
