doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        a(href="/") Return to the homepage
        .form-wrapper
            form(action="/update-cobj" method="POST")
                label(for="name") Name
                input(type="text" id="name" name="name" required)

                label(for="element") Element
                input(type="text" id="element" name="element" required)

                label(for="power_level") Power Level
                input(type="text" id="power_level" name="power_level" required)

                input(type="submit" value="Submit")
